# -----------------------------------------------------------------------------
# KA² — HEAVEN ENVIRONMENT CONFIGURATION
# -----------------------------------------------------------------------------

# Server Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Database Configuration (PostgreSQL in production / SQLite local fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ka2_heaven
DB_TYPE=sqlite
SQLITE_DB_PATH=./data/ka2_heaven.db

# Authentication & Security
JWT_ACCESS_SECRET=ka2_heaven_super_secret_access_jwt_key_2026_romantic_secure
JWT_REFRESH_SECRET=ka2_heaven_super_secret_refresh_jwt_key_2026_romantic_secure
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
ADMIN_INITIAL_PIN=2808
VAULT_MASTER_SALT=ka2_heaven_vault_master_salt_secure_2026

# Seed Credentials (Keerthi & Anu)
ADMIN_EMAIL=keerthi@ka2heaven.local
ADMIN_PASSWORD=Keerthi@Heaven2026!
USER_EMAIL=anu@ka2heaven.local
USER_PASSWORD=AnuSri@Heaven2026!

# Storage Configuration
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# WebRTC & STUN / TURN Configuration
STUN_SERVER_1=stun:stun.l.google.com:19302
STUN_SERVER_2=stun:stun1.l.google.com:19302
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Rate Limiting & Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
